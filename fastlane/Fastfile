
# LoopCaregiver Fastlane configuration.
# Signing repair branch is deliberately read-only; do not modify Loop signing.
default_platform(:ios)

TEAMID = ENV['TEAMID']
GH_PAT = ENV['GH_PAT']
GITHUB_WORKSPACE = ENV['GITHUB_WORKSPACE']
GITHUB_REPOSITORY_OWNER = ENV['GITHUB_REPOSITORY_OWNER']
FASTLANE_KEY_ID = ENV['FASTLANE_KEY_ID']
FASTLANE_ISSUER_ID = ENV['FASTLANE_ISSUER_ID']
FASTLANE_KEY = ENV['FASTLANE_KEY']
DEVICE_NAME = ENV['DEVICE_NAME']
DEVICE_ID = ENV['DEVICE_ID']
ENV['FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT'] = '120'

CAREGIVER_SIGNING_BRANCH = 'caregiver-original-p12-42468553947-1'

def caregiver_identifiers
  root = "com.#{TEAMID}.loopkit.LoopCaregiver"
  [root, "#{root}.IntentExtension", "#{root}.WidgetExtension",
   "#{root}.watchkitapp", "#{root}.watchkitapp.WidgetExtension"]
end

def caregiver_match_options
  opts = {
    type: 'appstore',
    git_url: "https://github.com/#{GITHUB_REPOSITORY_OWNER}/Match-Caregiver.git",
    git_branch: CAREGIVER_SIGNING_BRANCH,
    readonly: true,
    generate_apple_certs: false,
    git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
    app_identifier: caregiver_identifiers
  }
  if ENV['CAREGIVER_KEYCHAIN'] && !ENV['CAREGIVER_KEYCHAIN'].empty?
    opts[:keychain_name] = ENV['CAREGIVER_KEYCHAIN']
    opts[:keychain_password] = ENV.fetch('CAREGIVER_KEYCHAIN_PASSWORD')
  end
  opts
end

platform :ios do
  desc 'Build Caregiver with verified, existing signing profiles'
  lane :caregiver_build do
    # Workflow prepares and unlocks a dedicated keychain. setup_ci would create
    # another keychain and may hide the signing identity from xcodebuild.
    setup_ci if ENV['CI'] && ENV['CAREGIVER_KEYCHAIN'].to_s.empty?

    project = "#{GITHUB_WORKSPACE}/LoopCaregiver/LoopCaregiver.xcodeproj"
    update_project_team(path: project, teamid: TEAMID)

    api_key = app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )

    previous_build_number = latest_testflight_build_number(
      app_identifier: caregiver_identifiers.first,
      api_key: api_key,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: project,
      build_number: previous_build_number + 1
    )

    match(**caregiver_match_options)
    mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    UI.user_error!('Match did not return a provisioning profile mapping') unless mapping

    targets = {
      'LoopCaregiver' => caregiver_identifiers[0],
      'LoopCaregiverIntentExtension' => caregiver_identifiers[1],
      'LoopCaregiverWidgetExtension' => caregiver_identifiers[2],
      'LoopCaregiverWatchApp' => caregiver_identifiers[3],
      'LoopCaregiverWatchAppExtension' => caregiver_identifiers[4]
    }
    targets.each do |target, identifier|
      profile = mapping[identifier]
      UI.user_error!("Missing provisioning profile for #{identifier}") if profile.to_s.empty?
      update_code_signing_settings(
        path: project,
        profile_name: profile,
        code_sign_identity: 'Apple Distribution',
        targets: [target]
      )
    end

    gym(
      export_method: 'app-store',
      scheme: 'LoopCaregiver',
      output_name: 'LoopCaregiver.ipa',
      configuration: 'Release',
      destination: 'generic/platform=iOS',
      buildlog_path: 'buildlog'
    )

    copy_artifacts(
      target_path: 'artifacts',
      artifacts: ['*.mobileprovision', '*.ipa', '*.dSYM.zip']
    )
  end

  desc 'Push Caregiver to TestFlight'
  lane :caregiver_release do
    api_key = app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
    upload_to_testflight(
      api_key: api_key,
      skip_submission: false,
      ipa: 'LoopCaregiver.ipa',
      skip_waiting_for_build_processing: true
    )
  end

  desc 'Provision Caregiver Identifier'
  lane :caregiver_identifier do
    setup_ci if ENV['CI']
    app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
    def configure_bundle_id(name, identifier, capabilities)
      bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier) ||
        Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: 'IOS')
      existing = bundle_id.get_capabilities.map(&:capability_type)
      capabilities.reject { |cap| existing.include?(cap) }.each do |cap|
        bundle_id.create_capability(cap)
      end
    end
    caregiver_identifiers.zip([
      'LoopCaregiver', 'LoopCaregiverIntentExtension',
      'LoopCaregiverWidgetExtension', 'LoopCaregiverWatch',
      'LoopCaregiverWatchWidgetExtension'
    ]).each do |identifier, name|
      configure_bundle_id(name, identifier, [Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS])
    end
  end

  desc 'Inspect existing Caregiver certificate and profiles (read-only)'
  lane :certs do
    setup_ci if ENV['CI'] && ENV['CAREGIVER_KEYCHAIN'].to_s.empty?
    app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
    match(**caregiver_match_options)
  end

  desc 'Validate Secrets'
  lane :validate_secrets do
    setup_ci if ENV['CI']
    app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
    Spaceship::ConnectAPI::BundleId.find(caregiver_identifiers.first)
    match(**caregiver_match_options)
  end

  desc 'Nuke Certs (disabled to protect working Loop certificates)'
  lane :nuke_certs do
    UI.user_error!('Certificate revocation is disabled. Do not nuke shared Loop signing certificates.')
  end

  desc 'Check Distribution certificate expiry without renewal'
  lane :check_and_renew_certificates do
    app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
    certificates = Spaceship::ConnectAPI::Certificate.all
    distribution_certs = certificates.select { |cert| cert.certificate_type == 'DISTRIBUTION' }
    new_certificate_needed = distribution_certs.empty? || distribution_certs.any? do |cert|
      Time.parse(cert.expiration_date) < Time.now
    end
    File.write(File.expand_path('new_certificate_needed.txt'), new_certificate_needed ? 'true' : 'false')
    UI.message("Certificate review flag: #{new_certificate_needed}; no certificates were changed")
  end
end
